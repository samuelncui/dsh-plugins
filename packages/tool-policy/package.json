{
  "name": "@samuelncui/dsh-tool-policy",
  "version": "0.2.0",
  "description": "Deterministic allow/deny rules for DSH tool calls, evaluated before any model-based review.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "policy",
    "permission"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelncui/dsh-plugins.git",
    "directory": "packages/tool-policy"
  }
}
